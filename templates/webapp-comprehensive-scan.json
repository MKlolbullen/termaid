{
  "version": "3.0",
  "metadata": {
    "name": "Comprehensive Web Application Security Assessment",
    "description": "Typed DAG web assessment with scope enforcement, parallel discovery, adaptive testing, correlation, checkpoints, and explicit approval gates",
    "author": "0xDAYBULLEN",
    "version": "2.0",
    "methodology": "OWASP WSTG, PTES, NIST",
    "estimated_runtime": "3-6 hours",
    "complexity": "Advanced",
    "target_type": "Web Application",
    "stealth_level": "Medium",
    "coverage": [
      "OWASP Top 10 2021",
      "Authentication Testing",
      "Session Management",
      "Input Validation",
      "Business Logic",
      "Client-side Security"
    ]
  },
  "policy": {
    "allowed_roots": ["{{domain}}"],
    "excluded": [],
    "allow_intrusive": false,
    "max_concurrency": 12
  },
  "matrix": {
    "max_x": 17,
    "max_y": 7
  },
  "subgraphs": [
    {
      "id": "initial_recon",
      "name": "Initial Reconnaissance",
      "description": "Independent passive discovery workers",
      "parallel": true,
      "nodes": ["subfinder-1", "assetfinder-1", "crtsh-1"]
    },
    {
      "id": "service_discovery",
      "name": "Service Discovery",
      "description": "Independent service observations sharing one rate budget",
      "parallel": true,
      "nodes": ["naabu-1", "masscan-1"]
    },
    {
      "id": "surface_discovery",
      "name": "Application Surface Discovery",
      "description": "Technology, content, and crawler workers execute concurrently",
      "parallel": true,
      "nodes": ["whatweb-1", "dirsearch-1", "katana-1", "gospider-1"]
    },
    {
      "id": "parameter_discovery",
      "name": "Parameter Discovery",
      "parallel": true,
      "nodes": ["arjun-1", "paramspider-1", "x8-1"]
    },
    {
      "id": "passive_testing",
      "name": "Low-Impact Vulnerability Testing",
      "parallel": true,
      "nodes": ["nuclei-1", "jaeles-1", "gf-secrets-1"]
    },
    {
      "id": "adaptive_testing",
      "name": "Technology-Adaptive Testing",
      "parallel": true,
      "nodes": ["wordpress-nuclei-1", "graphql-nuclei-1"]
    },
    {
      "id": "focused_testing",
      "name": "Approval-Gated Focused Validation",
      "parallel": true,
      "nodes": ["sqlmap-1", "nosqlmap-1", "commix-1", "tplmap-1", "dalfox-1", "xsstrike-1", "kxss-1"]
    },
    {
      "id": "verification",
      "name": "Verification and Evidence",
      "parallel": true,
      "nodes": ["nuclei-verify-1", "manual-verify-1"]
    }
  ],
  "edges": [
    {"from": "input", "to": "scope-gate"},

    {"from": "scope-gate", "to": "subfinder-1"},
    {"from": "scope-gate", "to": "assetfinder-1"},
    {"from": "scope-gate", "to": "crtsh-1"},

    {"from": "subfinder-1", "to": "recon-merge"},
    {"from": "assetfinder-1", "to": "recon-merge"},
    {"from": "crtsh-1", "to": "recon-merge"},
    {"from": "recon-merge", "to": "dnsx-1"},

    {"from": "dnsx-1", "to": "naabu-1"},
    {"from": "dnsx-1", "to": "masscan-1"},
    {"from": "naabu-1", "to": "service-merge"},
    {"from": "masscan-1", "to": "service-merge"},
    {"from": "service-merge", "to": "service-to-url"},
    {"from": "service-to-url", "to": "httpx-1"},

    {"from": "httpx-1", "to": "whatweb-1"},
    {"from": "httpx-1", "to": "dirsearch-1"},
    {"from": "httpx-1", "to": "katana-1"},
    {"from": "httpx-1", "to": "gospider-1"},
    {"from": "httpx-1", "to": "surface-merge"},
    {"from": "dirsearch-1", "to": "surface-merge"},
    {"from": "katana-1", "to": "surface-merge"},
    {"from": "gospider-1", "to": "surface-merge"},
    {"from": "whatweb-1", "to": "tech-merge"},

    {"from": "surface-merge", "to": "arjun-1"},
    {"from": "surface-merge", "to": "paramspider-1"},
    {"from": "surface-merge", "to": "x8-1"},
    {"from": "arjun-1", "to": "parameter-merge"},
    {"from": "paramspider-1", "to": "parameter-merge"},
    {"from": "x8-1", "to": "parameter-merge"},

    {"from": "surface-merge", "to": "nuclei-1"},
    {"from": "surface-merge", "to": "jaeles-1"},
    {"from": "surface-merge", "to": "gf-secrets-1"},

    {"from": "surface-merge", "to": "wordpress-nuclei-1"},
    {"from": "tech-merge", "to": "wordpress-nuclei-1", "condition": "contains:wordpress", "label": "WordPress detected", "control": true},
    {"from": "surface-merge", "to": "graphql-nuclei-1"},
    {"from": "tech-merge", "to": "graphql-nuclei-1", "condition": "contains:graphql", "label": "GraphQL detected", "control": true},

    {"from": "parameter-merge", "to": "active-validation-gate", "condition": "nonempty"},
    {"from": "active-validation-gate", "to": "sqlmap-1"},
    {"from": "active-validation-gate", "to": "nosqlmap-1"},
    {"from": "active-validation-gate", "to": "commix-1"},
    {"from": "active-validation-gate", "to": "tplmap-1"},
    {"from": "active-validation-gate", "to": "dalfox-1"},
    {"from": "active-validation-gate", "to": "xsstrike-1"},
    {"from": "active-validation-gate", "to": "kxss-1"},

    {"from": "nuclei-1", "to": "finding-merge"},
    {"from": "jaeles-1", "to": "finding-merge"},
    {"from": "gf-secrets-1", "to": "finding-merge"},
    {"from": "wordpress-nuclei-1", "to": "finding-merge"},
    {"from": "graphql-nuclei-1", "to": "finding-merge"},
    {"from": "sqlmap-1", "to": "finding-merge"},
    {"from": "nosqlmap-1", "to": "finding-merge"},
    {"from": "commix-1", "to": "finding-merge"},
    {"from": "tplmap-1", "to": "finding-merge"},
    {"from": "dalfox-1", "to": "finding-merge"},
    {"from": "xsstrike-1", "to": "finding-merge"},
    {"from": "kxss-1", "to": "finding-merge"},
    {"from": "finding-merge", "to": "candidate-checkpoint"},

    {"from": "surface-merge", "to": "nuclei-verify-1"},
    {"from": "candidate-checkpoint", "to": "manual-verify-1"},
    {"from": "nuclei-verify-1", "to": "evidence-merge"},
    {"from": "manual-verify-1", "to": "evidence-merge"},
    {"from": "evidence-merge", "to": "report-sink"}
  ],
  "workflow": [
    {
      "id": "scope-gate",
      "kind": "gate",
      "tool": "scope",
      "transform": "scope",
      "inputs": ["domain"],
      "outputs": ["domain"],
      "children": ["subfinder-1", "assetfinder-1", "crtsh-1"],
      "layer": 1,
      "position": 0,
      "tags": ["scope", "policy"]
    },

    {
      "id": "subfinder-1",
      "kind": "worker",
      "tool": "subfinder",
      "args": "-d {{domain}} -all -recursive -silent",
      "inputs": ["domain"],
      "outputs": ["host"],
      "children": ["recon-merge"],
      "layer": 2,
      "position": 0,
      "parallel": true,
      "subgraph": "initial_recon",
      "sub_x": 0,
      "sub_y": 0,
      "execution": {"timeout_seconds": 300, "retries": 1, "retry_backoff_ms": 500}
    },
    {
      "id": "assetfinder-1",
      "kind": "worker",
      "tool": "assetfinder",
      "args": "--subs-only {{domain}}",
      "inputs": ["domain"],
      "outputs": ["host"],
      "children": ["recon-merge"],
      "layer": 2,
      "position": 1,
      "parallel": true,
      "subgraph": "initial_recon",
      "sub_x": 1,
      "sub_y": 0,
      "execution": {"timeout_seconds": 180, "retries": 1, "retry_backoff_ms": 500}
    },
    {
      "id": "crtsh-1",
      "kind": "worker",
      "tool": "crtsh",
      "args": "-domain {{domain}}",
      "inputs": ["domain"],
      "outputs": ["host"],
      "children": ["recon-merge"],
      "layer": 2,
      "position": 2,
      "parallel": true,
      "subgraph": "initial_recon",
      "sub_x": 2,
      "sub_y": 0,
      "execution": {"timeout_seconds": 180, "retries": 1, "retry_backoff_ms": 500}
    },
    {
      "id": "recon-merge",
      "kind": "merge",
      "tool": "merge",
      "inputs": ["host"],
      "outputs": ["host"],
      "children": ["dnsx-1"],
      "layer": 3,
      "position": 0
    },
    {
      "id": "dnsx-1",
      "kind": "worker",
      "tool": "dnsx",
      "args": "-l {{input}} -silent",
      "inputs": ["host"],
      "outputs": ["host"],
      "children": ["naabu-1", "masscan-1"],
      "layer": 4,
      "position": 0,
      "execution": {"timeout_seconds": 300, "retries": 1, "retry_backoff_ms": 500}
    },

    {
      "id": "naabu-1",
      "kind": "worker",
      "tool": "naabu",
      "args": "-l {{input}} -top-ports 1000 -exclude-ports 22,23,135,139,445,993,995 -silent",
      "inputs": ["host"],
      "outputs": ["service"],
      "children": ["service-merge"],
      "layer": 5,
      "position": 0,
      "parallel": true,
      "subgraph": "service_discovery",
      "sub_x": 0,
      "sub_y": 0,
      "execution": {"timeout_seconds": 900, "retries": 1, "retry_backoff_ms": 1000}
    },
    {
      "id": "masscan-1",
      "kind": "worker",
      "tool": "masscan",
      "args": "-iL {{input}} -p 80,443,8080,8443,3000,5000,8000,8888,9090 --rate 1000 -oG -",
      "inputs": ["host"],
      "outputs": ["service"],
      "children": ["service-merge"],
      "layer": 5,
      "position": 1,
      "parallel": true,
      "subgraph": "service_discovery",
      "sub_x": 1,
      "sub_y": 0,
      "execution": {"timeout_seconds": 900, "retries": 0}
    },
    {
      "id": "service-merge",
      "kind": "merge",
      "tool": "merge",
      "inputs": ["service"],
      "outputs": ["service"],
      "children": ["service-to-url"],
      "layer": 6,
      "position": 0
    },
    {
      "id": "service-to-url",
      "kind": "transform",
      "tool": "service-to-url",
      "transform": "host-to-url",
      "inputs": ["service"],
      "outputs": ["url"],
      "children": ["httpx-1"],
      "layer": 7,
      "position": 0
    },
    {
      "id": "httpx-1",
      "kind": "worker",
      "tool": "httpx",
      "args": "-l {{input}} -title -tech-detect -status-code -content-length -web-server -method -websocket -http2 -follow-redirects -location -favicon -jarm -asn -cdn -silent",
      "inputs": ["url"],
      "outputs": ["url"],
      "children": ["whatweb-1", "dirsearch-1", "katana-1", "gospider-1", "surface-merge"],
      "layer": 8,
      "position": 0,
      "execution": {"timeout_seconds": 600, "retries": 1, "retry_backoff_ms": 750}
    },

    {
      "id": "whatweb-1",
      "kind": "worker",
      "tool": "whatweb",
      "args": "-i {{input}} --color=never --no-errors -a 3",
      "inputs": ["url"],
      "outputs": ["technology"],
      "children": ["tech-merge"],
      "layer": 9,
      "position": 0,
      "parallel": true,
      "subgraph": "surface_discovery",
      "sub_x": 0,
      "sub_y": 0,
      "execution": {"timeout_seconds": 600, "retries": 0}
    },
    {
      "id": "dirsearch-1",
      "kind": "worker",
      "tool": "dirsearch",
      "args": "-l {{input}} -w ~/.local/share/termaid/wordlists/SecLists/Discovery/Web-Content/common.txt -e php,html,txt,js,json,xml,pdf,zip,bak,old -t 30 --format=plain",
      "inputs": ["url"],
      "outputs": ["url"],
      "children": ["surface-merge"],
      "layer": 9,
      "position": 1,
      "parallel": true,
      "subgraph": "surface_discovery",
      "sub_x": 1,
      "sub_y": 0,
      "execution": {"timeout_seconds": 1200, "retries": 0}
    },
    {
      "id": "katana-1",
      "kind": "worker",
      "tool": "katana",
      "args": "-list {{input}} -d 3 -jc -kf all -jsl -aff -xhr -form -scope {{domain}} -silent",
      "inputs": ["url"],
      "outputs": ["url"],
      "children": ["surface-merge"],
      "layer": 9,
      "position": 2,
      "parallel": true,
      "subgraph": "surface_discovery",
      "sub_x": 2,
      "sub_y": 0,
      "execution": {"timeout_seconds": 1200, "retries": 1, "retry_backoff_ms": 750}
    },
    {
      "id": "gospider-1",
      "kind": "worker",
      "tool": "gospider",
      "args": "-S {{input}} -d 3 -c 20 -t 10 --include-subs --include-other-source -a -w -r",
      "inputs": ["url"],
      "outputs": ["url"],
      "children": ["surface-merge"],
      "layer": 9,
      "position": 3,
      "parallel": true,
      "subgraph": "surface_discovery",
      "sub_x": 3,
      "sub_y": 0,
      "execution": {"timeout_seconds": 1200, "retries": 0}
    },
    {
      "id": "surface-merge",
      "kind": "merge",
      "tool": "merge",
      "inputs": ["url"],
      "outputs": ["url"],
      "children": ["arjun-1", "paramspider-1", "x8-1", "nuclei-1", "jaeles-1", "gf-secrets-1", "wordpress-nuclei-1", "graphql-nuclei-1", "nuclei-verify-1"],
      "layer": 10,
      "position": 0
    },
    {
      "id": "tech-merge",
      "kind": "merge",
      "tool": "merge",
      "inputs": ["technology"],
      "outputs": ["technology"],
      "children": ["wordpress-nuclei-1", "graphql-nuclei-1"],
      "layer": 10,
      "position": 1
    },

    {
      "id": "arjun-1",
      "kind": "worker",
      "tool": "arjun",
      "args": "-i {{input}} -oT {{output}} --stable -t 20 -d 1 -w ~/.local/share/termaid/wordlists/SecLists/Discovery/Web-Content/burp-parameter-names.txt",
      "inputs": ["url"],
      "outputs": ["parameter"],
      "children": ["parameter-merge"],
      "layer": 11,
      "position": 0,
      "parallel": true,
      "subgraph": "parameter_discovery",
      "sub_x": 0,
      "sub_y": 0,
      "execution": {"timeout_seconds": 1200, "retries": 0}
    },
    {
      "id": "paramspider-1",
      "kind": "worker",
      "tool": "paramspider",
      "args": "-d {{domain}} -s",
      "inputs": ["url"],
      "outputs": ["parameter"],
      "children": ["parameter-merge"],
      "layer": 11,
      "position": 1,
      "parallel": true,
      "subgraph": "parameter_discovery",
      "sub_x": 1,
      "sub_y": 0,
      "execution": {"timeout_seconds": 600, "retries": 1, "retry_backoff_ms": 500}
    },
    {
      "id": "x8-1",
      "kind": "worker",
      "tool": "x8",
      "args": "-u {{input}} -w ~/.local/share/termaid/wordlists/SecLists/Discovery/Web-Content/burp-parameter-names.txt",
      "inputs": ["url"],
      "outputs": ["parameter"],
      "children": ["parameter-merge"],
      "layer": 11,
      "position": 2,
      "parallel": true,
      "subgraph": "parameter_discovery",
      "sub_x": 2,
      "sub_y": 0,
      "execution": {"timeout_seconds": 1200, "retries": 0}
    },

    {
      "id": "nuclei-1",
      "kind": "worker",
      "tool": "nuclei",
      "args": "-l {{input}} -t ~/nuclei-templates/ -severity medium,high,critical -exclude-tags dos,fuzz -rl 50 -c 25 -timeout 15 -retries 2 -no-color -silent -jsonl",
      "inputs": ["url"],
      "outputs": ["finding"],
      "children": ["finding-merge"],
      "layer": 11,
      "position": 3,
      "parallel": true,
      "subgraph": "passive_testing",
      "sub_x": 0,
      "sub_y": 0,
      "execution": {"timeout_seconds": 1800, "retries": 1, "retry_backoff_ms": 1000}
    },
    {
      "id": "jaeles-1",
      "kind": "worker",
      "tool": "jaeles",
      "args": "scan -U {{input}} --config ~/.config/jaeles/",
      "inputs": ["url"],
      "outputs": ["finding"],
      "children": ["finding-merge"],
      "layer": 11,
      "position": 4,
      "parallel": true,
      "subgraph": "passive_testing",
      "sub_x": 1,
      "sub_y": 0,
      "execution": {"timeout_seconds": 1800, "retries": 0}
    },
    {
      "id": "gf-secrets-1",
      "kind": "worker",
      "tool": "gf",
      "args": "secrets {{input}}",
      "inputs": ["url"],
      "outputs": ["finding"],
      "children": ["finding-merge"],
      "layer": 11,
      "position": 5,
      "parallel": true,
      "subgraph": "passive_testing",
      "sub_x": 2,
      "sub_y": 0,
      "execution": {"timeout_seconds": 300, "retries": 0}
    },

    {
      "id": "wordpress-nuclei-1",
      "kind": "worker",
      "tool": "nuclei",
      "args": "-l {{input}} -tags wordpress -severity medium,high,critical -exclude-tags dos,fuzz -rl 25 -c 10 -silent -jsonl",
      "inputs": ["url"],
      "outputs": ["finding"],
      "children": ["finding-merge"],
      "layer": 11,
      "position": 6,
      "parallel": true,
      "subgraph": "adaptive_testing",
      "sub_x": 0,
      "sub_y": 0,
      "execution": {"timeout_seconds": 900, "retries": 0}
    },
    {
      "id": "graphql-nuclei-1",
      "kind": "worker",
      "tool": "nuclei",
      "args": "-l {{input}} -tags graphql -severity medium,high,critical -exclude-tags dos,fuzz -rl 25 -c 10 -silent -jsonl",
      "inputs": ["url"],
      "outputs": ["finding"],
      "children": ["finding-merge"],
      "layer": 11,
      "position": 7,
      "parallel": true,
      "subgraph": "adaptive_testing",
      "sub_x": 1,
      "sub_y": 0,
      "execution": {"timeout_seconds": 900, "retries": 0}
    },

    {
      "id": "parameter-merge",
      "kind": "merge",
      "tool": "merge",
      "inputs": ["parameter"],
      "outputs": ["parameter"],
      "children": ["active-validation-gate"],
      "layer": 12,
      "position": 0
    },
    {
      "id": "active-validation-gate",
      "kind": "gate",
      "tool": "approval",
      "inputs": ["parameter"],
      "outputs": ["parameter"],
      "children": ["sqlmap-1", "nosqlmap-1", "commix-1", "tplmap-1", "dalfox-1", "xsstrike-1", "kxss-1"],
      "layer": 13,
      "position": 0,
      "policy": {"requires_approval": true, "approval": "active-validation"},
      "tags": ["approval", "intrusive-boundary"]
    },

    {
      "id": "sqlmap-1",
      "kind": "worker",
      "tool": "sqlmap",
      "args": "-m {{input}} --batch --smart --level=2 --risk=1 --threads=3 --technique=BEUSTQ",
      "inputs": ["parameter"],
      "outputs": ["finding"],
      "children": ["finding-merge"],
      "layer": 14,
      "position": 0,
      "parallel": true,
      "subgraph": "focused_testing",
      "sub_x": 0,
      "sub_y": 0,
      "policy": {"intrusive": true, "approval": "active-validation"},
      "execution": {"timeout_seconds": 1800, "retries": 0}
    },
    {
      "id": "nosqlmap-1",
      "kind": "worker",
      "tool": "nosqlmap",
      "args": "-f {{input}} --scan --batch",
      "inputs": ["parameter"],
      "outputs": ["finding"],
      "children": ["finding-merge"],
      "layer": 14,
      "position": 1,
      "parallel": true,
      "subgraph": "focused_testing",
      "sub_x": 1,
      "sub_y": 0,
      "policy": {"intrusive": true, "approval": "active-validation"},
      "execution": {"timeout_seconds": 1800, "retries": 0}
    },
    {
      "id": "commix-1",
      "kind": "worker",
      "tool": "commix",
      "args": "-m {{input}} --batch --level=2 --risk=1",
      "inputs": ["parameter"],
      "outputs": ["finding"],
      "children": ["finding-merge"],
      "layer": 14,
      "position": 2,
      "parallel": true,
      "subgraph": "focused_testing",
      "sub_x": 2,
      "sub_y": 0,
      "policy": {"intrusive": true, "approval": "active-validation"},
      "execution": {"timeout_seconds": 1800, "retries": 0}
    },
    {
      "id": "tplmap-1",
      "kind": "worker",
      "tool": "tplmap",
      "args": "-f {{input}} --engine all",
      "inputs": ["parameter"],
      "outputs": ["finding"],
      "children": ["finding-merge"],
      "layer": 14,
      "position": 3,
      "parallel": true,
      "subgraph": "focused_testing",
      "sub_x": 3,
      "sub_y": 0,
      "policy": {"intrusive": true, "approval": "active-validation"},
      "execution": {"timeout_seconds": 1800, "retries": 0}
    },
    {
      "id": "dalfox-1",
      "kind": "worker",
      "tool": "dalfox",
      "args": "file {{input}} --silence --worker 50 --delay 100 --timeout 10 --deep-domxss --format json",
      "inputs": ["parameter"],
      "outputs": ["finding"],
      "children": ["finding-merge"],
      "layer": 14,
      "position": 4,
      "parallel": true,
      "subgraph": "focused_testing",
      "sub_x": 4,
      "sub_y": 0,
      "policy": {"intrusive": true, "approval": "active-validation"},
      "execution": {"timeout_seconds": 1800, "retries": 0}
    },
    {
      "id": "xsstrike-1",
      "kind": "worker",
      "tool": "xsstrike",
      "args": "-f {{input}} --fuzzer --crawl --seeds 25",
      "inputs": ["parameter"],
      "outputs": ["finding"],
      "children": ["finding-merge"],
      "layer": 14,
      "position": 5,
      "parallel": true,
      "subgraph": "focused_testing",
      "sub_x": 5,
      "sub_y": 0,
      "policy": {"intrusive": true, "approval": "active-validation"},
      "execution": {"timeout_seconds": 1800, "retries": 0}
    },
    {
      "id": "kxss-1",
      "kind": "worker",
      "tool": "kxss",
      "args": "-l {{input}}",
      "inputs": ["parameter"],
      "outputs": ["finding"],
      "children": ["finding-merge"],
      "layer": 14,
      "position": 6,
      "parallel": true,
      "subgraph": "focused_testing",
      "sub_x": 6,
      "sub_y": 0,
      "policy": {"intrusive": true, "approval": "active-validation"},
      "execution": {"timeout_seconds": 900, "retries": 0}
    },

    {
      "id": "finding-merge",
      "kind": "merge",
      "tool": "merge",
      "inputs": ["finding"],
      "outputs": ["finding"],
      "children": ["candidate-checkpoint"],
      "layer": 15,
      "position": 0,
      "policy": {"continue_on_error": true}
    },
    {
      "id": "candidate-checkpoint",
      "kind": "checkpoint",
      "tool": "checkpoint",
      "inputs": ["finding"],
      "outputs": ["finding"],
      "children": ["manual-verify-1"],
      "layer": 16,
      "position": 0
    },
    {
      "id": "nuclei-verify-1",
      "kind": "worker",
      "tool": "nuclei",
